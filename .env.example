# Server Configuration
PORT=3000
# For local development:
BASE_URL=http://localhost:3000
# For production (e.g., Render): Set to your full HTTPS URL
# BASE_URL=https://your-app.onrender.com

# Environment (development or production)
NODE_ENV=development
# For production deployments, set: NODE_ENV=production

# Data Directory (for persistent storage)
# Local development: ./data (default)
# Production (Render): /var/data (auto-configured from NODE_ENV)
# Override with: DATA_DIR=/custom/path
# DATA_DIR=/var/data

# Session Secret (generate a random string - REQUIRED for production)
SESSION_SECRET=your-super-secret-session-key-change-this

# Google OAuth (get from https://console.developers.google.com/)
# IMPORTANT: Add your callback URL to Google Console:
#   - Development: http://localhost:3000/auth/google/callback
#   - Production: https://your-app.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: Weather API (for weather forecasts)
OPENWEATHER_API_KEY=your-openweathermap-api-key

# OpenRouteService API (get free key from https://openrouteservice.org/dev/#/signup)
OPENROUTE_API_KEY="your-key"
